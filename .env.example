# Example environment variables for local development

# Frontend
# URL base for the API used by the frontend (Vite env name)
VITE_API_BASE=http://localhost:8000

# Backend (FastAPI) - MySQL connection parts
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=todo_db

# Optional single connection string alternative (uncomment if supported by your backend)
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
